# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Upstox (Indian index F&O) -------------------------------------------
# Daily access token. Treat as a live bearer credential.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8080/callback

# ---- Project-N (US equities) ---------------------------------------------
# The default daily-bar source needs no key. Set these only if you switch to a
# paid intraday feed.
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=

# ---- optional: news / sentiment ------------------------------------------
NEWS_API_KEY=
